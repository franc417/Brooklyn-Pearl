# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# service_role key — server-only, NEVER expose to the browser, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Pesapal (card payments) ──────────────────────────────────────────────
# From your Pesapal merchant dashboard → API Keys
PESAPAL_CONSUMER_KEY=your-consumer-key
PESAPAL_CONSUMER_SECRET=your-consumer-secret
# "sandbox" while testing, "live" once you have a verified merchant account
PESAPAL_ENV=sandbox
# Set after you register your IPN URL once (see README) — looks like a UUID
PESAPAL_IPN_ID=

# ── M-Pesa Daraja (direct STK Push) ──────────────────────────────────────
# From developer.safaricom.co.ke → My Apps → your app → Keys
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
# "sandbox" while testing, "production" once you have a real Paybill/Till
MPESA_ENV=sandbox
# Leave blank to use Safaricom's shared sandbox shortcode/passkey (174379) —
# only set these once you have real production credentials
MPESA_SHORTCODE=
MPESA_PASSKEY=

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
NOTIFICATION_EMAIL_FROM="Brooklyn Pearl Resort <reservations@yourdomain.com>"
NOTIFICATION_EMAIL_TO=info@brooklynpearlresort.com

# ── App ──────────────────────────────────────────────────────────────────
# Your production URL once deployed, e.g. https://brooklynpearlresort.com
# Used to build Pesapal callback/IPN URLs and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
